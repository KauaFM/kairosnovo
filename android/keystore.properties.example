# Modelo. Copie para android/keystore.properties e preencha.
#
# O arquivo real NUNCA vai para o git, e o .jks também não: quem tiver os dois
# consegue publicar atualizações do ORVAX no seu nome na Play Store.
#
# Guarde o .jks e estas senhas em DOIS lugares (gerenciador de senhas + backup
# offline). Se você perder o keystore, o Google não recupera: o app fica
# congelado para sempre na última versão publicada, e a única saída é publicar
# um app novo, com outro applicationId, perdendo instalações e avaliações.

storeFile=C:/caminho/para/orvax-release.jks
storePassword=SUA_SENHA_DO_KEYSTORE
keyAlias=orvax
keyPassword=SUA_SENHA_DA_CHAVE
