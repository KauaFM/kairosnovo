# ============================================
# ORVAX — Environment Variables Template
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env real (está no .gitignore)
# ============================================

# Supabase (obter em https://app.supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Gemini (IA PRINCIPAL do mentor + estimador de XP) — tier gratuito
# Obter em: https://aistudio.google.com/apikey  (chave começa com AIza...)
VITE_GEMINI_API_KEY=

# OpenAI gpt-4o-mini — fallback do mentor/XP + FitCal vision (visão ainda usa OpenAI)
# Obter em: https://platform.openai.com/api-keys
# ATENÇÃO: VITE_* fica VISÍVEL no bundle do cliente. Para prod, mover
# as chamadas pra Edge Function no Supabase com secret no servidor.
VITE_OPENAI_API_KEY=

# OpenAI do Edge Function whatsapp-agent (NUNCA aqui — use Supabase secrets)
# Configure via: supabase secrets set OPENAI_API_KEY=sk-...

# n8n webhook (opcional — para integração WhatsApp)
VITE_N8N_WEBHOOK_URL=

# Admin email (reconhecimento no front)
VITE_ADMIN_EMAIL=seu@email.com
